{
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/robots.txt", "destination": "/api/index.py" },
    { "source": "/sitemap.xml", "destination": "/api/index.py" },
    { "source": "/how-to-use.html", "destination": "/api/index.py" },
    { "source": "/grading.html", "destination": "/api/index.py" },
    { "source": "/about.html", "destination": "/api/index.py" },
    { "source": "/privacy.html", "destination": "/api/index.py" },
    { "source": "/disclaimer.html", "destination": "/api/index.py" },
    { "source": "/", "destination": "/index.html" }
  ]
}
